<odoo>
	<record id="view_product_cost_history_search_inherit_realistic" model="ir.ui.view">
		<field name="name">product.cost.history.search.inherit.realistic</field>
		<field name="model">product.cost.history</field>
		<field name="inherit_id" ref="cost_tracking.view_product_cost_history_search"/>
		<field name="arch" type="xml">
			<xpath expr="//filter[@name='filter_fifo']" position="after">
				<filter string="SN AVCO" name="filter_realistic" domain="[('cost_method', '=', 'sn_avco')]"/>
			</xpath>
		</field>
	</record>
</odoo>