<odoo>
	<record id="view_product_template_inherit_realistic" model="ir.ui.view">
		<field name="name">product.template.product.form.inherit.sn_avco</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_only_form_view"/>
		<field name="arch" type="xml">
			<xpath expr="//div[@name='button_box']" position="inside">
				<button name="action_view_template_cost_history" type="object" class="oe_stat_button" icon="fa-history" string="Cost History"/>
				<button name="action_view_all_variants_cost" type="object" class="oe_stat_button" icon="fa-usd" string="Variants Cost"/>
			</xpath>
		</field>
	</record>
</odoo>