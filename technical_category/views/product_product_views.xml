<odoo>
	<record id="view_product_product_inherit_technical_categ" model="ir.ui.view">
		<field name="name">product.product.form.inherit.technical_categ</field>
		<field name="model">product.product</field>
		<field name="inherit_id" ref="product.product_normal_form_view"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='categ_id']" position="after">
				<field name="technical_categ_id" widget="Selection"/>
			</xpath>
		</field>
	</record>
</odoo>