<odoo>
		<!-- List View -->
	<record id="product_category_technical_tree" model="ir.ui.view">
		<field name="name">product.category.technical.tree</field>
		<field name="model">product.category.technical</field>
		<field name="arch" type="xml">
			<list>
				<field name="display_name"/>
				<field name="tag_ids" widget="many2many_tags"/>
			</list>
		</field>
	</record>

	<!-- Form View -->
	<record id="product_category_technical_form" model="ir.ui.view">
		<field name="name">product.category.technical.form</field>
		<field name="model">product.category.technical</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="parent_id" widget="selection" nocreate="1"/>
						<field id="category_name" name="name" placeholder="Enter a name" autocomplete="off"/>
						<field id="tag_name" name="tag_ids" widget="many2many_tags"/>
					</group>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="action_technical_category" model="ir.actions.act_window">
		<field name="name">Technical Category</field>
		<field name="res_model">product.category.technical</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem 
		id="menu_product_in_config_stock_technical_category" 
		name="Technical Categories" 
		parent="stock.menu_product_in_config_stock" 
		action="action_technical_category"
		sequence="3"
	/>
</odoo>